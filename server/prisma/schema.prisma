generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  DIRECTOR
  HOD
  TEACHER
  STUDENT
}

// --- CORE ORGANIZATIONAL STRUCTURE ---

model Department {
  id       String    @id @default(uuid())
  name     String    @unique // e.g. "Computer Science & Engineering"
  
  users    User[]    // All students and faculty belong to a home department
  rooms    Room[]    // Labs/Rooms controlled by this department
  subjects Subject[] // Courses offered by this department
}

model Room {
  id           String     @id @default(uuid())
  name         String     @unique // e.g. "L201"
  qrPayload    String     @unique // The physical QR code sticker
  capacity     Int        @default(60) // To ensure HOD doesn't overbook the room!
  
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  
  timetables   Timetable[]
}

model Subject {
  id           String     @id @default(uuid())
  code         String     @unique // e.g. "TCS-601"
  name         String
  
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  // Many-to-Many Relations handled magically by Prisma!
  qualifiedTeachers User[] @relation("TeacherSubjects")
  enrolledStudents  User[] @relation("StudentSubjects")

  timetables   Timetable[]
}

// --- USER MANAGEMENT ---

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  name     String
  role     Role   @default(STUDENT)
  batch    String? // for students only
  semester Int?    // for students only 
  year     Int?    // for students only 
  contactNumber String? // for all users
  roleNumber String? // for all students
  studentType String? // REGULAR or LATERAL_ENTRY
  // Hardware Locking for Students
  deviceId      String? @unique
  deviceBoundAt DateTime?

  // Relations
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  // A Teacher/HOD can teach many subjects
  taughtSubjects Subject[] @relation("TeacherSubjects")
  
  // A Student can be enrolled in many subjects
  enrolledSubjects Subject[] @relation("StudentSubjects")

  // Timetables where this user is the Teacher
  timetables    Timetable[]
  attendances   Attendance[]
}

// --- SCHEDULING & ATTENDANCE ---

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Timetable {
  id        String    @id @default(uuid())
  dayOfWeek DayOfWeek
  startTime String 
  endTime   String
  batch     String? // for students only

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  teacherId String
  teacher   User    @relation(fields: [teacherId], references: [id])

  roomId    String
  room      Room    @relation(fields: [roomId], references: [id])

  sessions  Session[]

  // SECURITY: Prevent Double Booking!
  // A Teacher cannot be in two places at once.
  @@unique([teacherId, dayOfWeek, startTime])
  // A Room cannot host two classes at once.
  @@unique([roomId, dayOfWeek, startTime])
}

model Session {
  id          String   @id @default(uuid())
  status      String   @default("ACTIVE") // ACTIVE, CLOSED
  startedAt   DateTime @default(now())

  timetableId String
  timetable   Timetable @relation(fields: [timetableId], references: [id])

  attendances Attendance[]
}

model Attendance {
  id       String   @id @default(uuid())
  markedAt DateTime @default(now())

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id])

  studentId String
  student   User   @relation(fields: [studentId], references: [id])

  // SECURITY: A student cannot be marked present twice in the same class
  @@unique([studentId, sessionId])
}
